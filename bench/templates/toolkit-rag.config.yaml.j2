{# Auto-generated by bench sweep — do not edit manually.
   Variables (all required unless noted):
     config_id          str   — sweep config identifier
     project_name       str   — toolkit project name
     collection_name    str   — "docs" or "code"
     collection_description  str
     model              str   — fastembed model id
     dimensions         int   — embedding dimensions
     sources            list  — each item: {path (abs), patterns, recursive, chunking?}
       source.chunking (optional): {strategy, max_tokens?, overlap_tokens?, max_chars?, language?}
     chunking_strategy  str   — collection-level strategy
     chunking_max_tokens     int|None  — docs collection chunk size in tokens
     chunking_overlap_tokens int|None  — docs overlap (usually chunk_size // 2)
     chunking_max_chars      int|None  — code collection chunk size in chars
     chunking_split_headers  list|None — e.g. ["h1","h2","h3"]
     chunking_languages      dict|None — {".py": "python", ...}
     model_cache_dir    str   — absolute path to shared model cache
     search_default_top_k    int
     search_max_top_k        int
     search_rrf_k            int
     search_vector_candidates int
     search_fts_candidates   int
#}
# Generated by bench sweep — config_id: {{ config_id }}

project:
  name: "{{ project_name }}"

collections:
  {{ collection_name }}:
    description: "{{ collection_description }}"
    embedding:
      model: "{{ model }}"
      dimensions: {{ dimensions }}
    sources:
{% for source in sources %}
      - path: "{{ source.path }}"
        patterns: {{ source.patterns | tojson }}
        recursive: {{ "true" if source.recursive else "false" }}
{% if source.chunking is defined and source.chunking %}
        chunking:
          strategy: "{{ source.chunking.strategy }}"
{% if source.chunking.max_tokens is defined and source.chunking.max_tokens is not none %}
          max_tokens: {{ source.chunking.max_tokens }}
{% endif %}
{% if source.chunking.overlap_tokens is defined and source.chunking.overlap_tokens is not none %}
          overlap_tokens: {{ source.chunking.overlap_tokens }}
{% endif %}
{% if source.chunking.max_chars is defined and source.chunking.max_chars is not none %}
          max_chars: {{ source.chunking.max_chars }}
{% endif %}
{% if source.chunking.language is defined and source.chunking.language is not none %}
          language: "{{ source.chunking.language }}"
{% endif %}
{% endif %}
{% endfor %}
    chunking:
      strategy: "{{ chunking_strategy }}"
{% if chunking_max_tokens is not none %}
      max_tokens: {{ chunking_max_tokens }}
{% endif %}
{% if chunking_overlap_tokens is not none %}
      overlap_tokens: {{ chunking_overlap_tokens }}
{% endif %}
{% if chunking_max_chars is not none %}
      max_chars: {{ chunking_max_chars }}
{% endif %}
{% if chunking_split_headers %}
      split_headers: {{ chunking_split_headers | tojson }}
{% endif %}
{% if chunking_languages %}
      languages:
{% for ext, lang in chunking_languages.items() %}
        "{{ ext }}": "{{ lang }}"
{% endfor %}
{% endif %}

shared:
  cache_dir: "{{ model_cache_dir }}"

database:
  path: ".rag/knowledge.db"

search:
  default_top_k: {{ search_default_top_k }}
  max_top_k: {{ search_max_top_k }}
  rrf_k: {{ search_rrf_k }}
  vector_candidates: {{ search_vector_candidates }}
  fts_candidates: {{ search_fts_candidates }}
